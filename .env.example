# Copy to .env (or run: python scripts/make_env.py, which also generates the
# secrets). .env is git-ignored; never commit real values.

# ---- Application ------------------------------------------------------------
# dev | test | prod. prod refuses a weak JWT_SECRET.
APP_ENV=prod
LOG_LEVEL=INFO
# port nginx publishes on the host
HOST_PORT=8000
# number of API containers behind nginx
APP_REPLICAS=3
# larger request bodies get 413
MAX_BODY_BYTES=300000
# comma-separated origins; empty = CORS disabled
CORS_ALLOW_ORIGINS=
# Compose sets this to true (app sits behind nginx)
TRUST_PROXY_HEADERS=false
# false hides Swagger UI (/docs) and /openapi.json
DOCS_ENABLED=true

# ---- Authentication ---------------------------------------------------------
# REQUIRED. >= 32 random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
# first ADMIN, created by the init job
ADMIN_USERNAME=admin
# REQUIRED. >= 10 chars with a letter and a digit
ADMIN_PASSWORD=
# optional static bearer token for a Prometheus scraper
METRICS_SCRAPE_TOKEN=

# ---- Qdrant (vector database) -----------------------------------------------
# Compose overrides this with http://qdrant:6333
QDRANT_URL=http://localhost:6333
# only for a managed/secured Qdrant
QDRANT_API_KEY=
# false = store usage metadata only, no question/answer text
STORE_CHAT_CONTENT=true

# ---- Redis ------------------------------------------------------------------
# Compose overrides this with redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
# /chat requests per user per window
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
# failed logins per username+IP before lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600

# ---- LLM gateway ------------------------------------------------------------
# mock | openai_compatible
LLM_PROVIDER=mock
# empty | mock | openai_compatible (must differ from LLM_PROVIDER)
LLM_FALLBACK_PROVIDER=
# extra model names clients may request, comma-separated
LLM_ALLOWED_MODELS=
# per attempt
LLM_TIMEOUT_SECONDS=15
# per request, across all retries and the fallback
LLM_OVERALL_DEADLINE_SECONDS=40
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=8
# in-flight LLM calls per replica
LLM_MAX_CONCURRENCY=20
# max wait for a free slot before shedding with 503
LLM_QUEUE_WAIT_SECONDS=5
LLM_MAX_OUTPUT_TOKENS=512
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SECONDS=30
# artificial delay of the mock provider (for load experiments)
MOCK_LATENCY_SECONDS=0

# OpenAI-compatible provider (OpenAI, Groq, OpenRouter, Together, Ollama, vLLM, ...).
# Take the base URL and the model name from your provider's current documentation.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# some newer models need max_completion_tokens
OPENAI_MAX_TOKENS_PARAM=max_tokens

# ---- RAG --------------------------------------------------------------------
RAG_ENABLED=true
# chunks handed to the LLM
RAG_TOP_K=4
# minimum cosine similarity for a chunk to count
RAG_SCORE_THRESHOLD=0.08
# characters
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_MAX_DOCUMENT_CHARS=200000
# hash (offline, lexical) | openai_compatible (semantic)
EMBEDDING_PROVIDER=hash
# vector size: 2048 suits the hash embedder; for a real model use its output size
EMBEDDING_DIM=2048
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
